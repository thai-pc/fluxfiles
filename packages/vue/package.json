{
  "name": "@fluxfiles/vue",
  "version": "1.0.2",
  "description": "Vue 3 components and composables for FluxFiles file manager, with Nuxt 3 auto-import support",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "author": "thai-pc",
  "homepage": "https://github.com/thai-pc/fluxfiles#framework-adapters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thai-pc/fluxfiles.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/thai-pc/fluxfiles/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fluxfiles",
    "file-manager",
    "vue",
    "vue3",
    "nuxt",
    "nuxt3",
    "s3",
    "r2",
    "upload"
  ],
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
