{
    "name": "fluxfiles/fluxfiles",
    "description": "Standalone PHP file manager with multi-storage support (Local/S3/R2)",
    "type": "library",
    "license": "MIT",
    "keywords": ["file-manager", "s3", "r2", "flysystem", "upload", "media", "storage", "jwt"],
    "homepage": "https://github.com/thai-pc/fluxfiles",
    "authors": [
        {
            "name": "thai-pc",
            "homepage": "https://github.com/thai-pc"
        }
    ],
    "support": {
        "issues": "https://github.com/thai-pc/fluxfiles/issues",
        "source": "https://github.com/thai-pc/fluxfiles"
    },
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.0",
        "intervention/image": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maennchen/zipstream-php": "^3.1"
    },
    "suggest": {
        "ext-pdo": "Required when FLUXFILES_STORAGE_BACKEND=db (any driver)",
        "ext-pdo_sqlite": "Required when FLUXFILES_STORAGE_BACKEND=db with a sqlite: DSN",
        "ext-pdo_mysql": "Required when FLUXFILES_STORAGE_BACKEND=db with a mysql: DSN",
        "ext-pdo_pgsql": "Required when FLUXFILES_STORAGE_BACKEND=db with a pgsql: DSN"
    },
    "autoload": {
        "psr-4": {
            "FluxFiles\\": "api/"
        },
        "files": ["modules-autoload.php"]
    },
    "bin": [
        "bin/fluxfiles"
    ],
    "minimum-stability": "stable"
}
