# FluxFiles core — copy to `.env` in this package root and fill in.
# The API loads `.env` from the package root first (then the monorepo root in a
# dev checkout). Every value below is optional except FLUXFILES_SECRET.

# App
# Must be at least 32 bytes (256-bit) — firebase/php-jwt v7 rejects shorter HS256 keys.
FLUXFILES_SECRET=change-me-to-random-32-char-string
# Comma-separated origins allowed for CORS + CSRF (mutating requests). Empty = same-origin only.
FLUXFILES_ALLOWED_ORIGINS=http://localhost:3000

# AWS S3 (only needed if you use the `s3` disk — see config/disks.php)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
# Custom S3-compatible endpoint — empty for native AWS S3; set for MinIO /
# DigitalOcean Spaces / other S3-compatibles (e.g. http://localhost:9000).
AWS_ENDPOINT=
# 'private' → short-lived presigned GET URLs (default). 'public' → direct object URLs.
AWS_VISIBILITY=private
# Optional CDN / custom domain base for a public disk, e.g. https://cdn.example.com
AWS_PUBLIC_URL=

# Cloudflare R2 (only needed if you use the `r2` disk)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
# 'public' relies on a public bucket + R2_PUBLIC_URL (r2.dev / custom domain); 'private' = presigned.
R2_VISIBILITY=private
R2_PUBLIC_URL=

# Locale (optional, default: en)
# Supported: en, vi, zh, ja, ko, fr, de, es, ar, pt, it, ru, th, hi, tr, nl
# Leave empty for English. Users can override via ?lang= or ?locale= URL param.
FLUXFILES_LOCALE=

# Rate limit (optional; per user, requests/min). Tokens can override per tenant.
# FLUXFILES_RATE_LIMIT_READ=60
# FLUXFILES_RATE_LIMIT_WRITE=100

# Import from URL (optional). The feature is enabled per-tenant via the
# `allow_url_import` JWT claim; these are server-wide defaults/limits.
# FLUXFILES_IMPORT_MAX_MB=50            # max MB per import when the token doesn't set max_import_mb
# FLUXFILES_IMPORT_TIMEOUT=30           # seconds per import fetch
# FLUXFILES_IMPORT_RATE_LIMIT=10        # imports/min when the token doesn't set import_rate_limit
# FLUXFILES_IMPORT_ALLOW_SVG=false      # SVG import is off by default (XML can carry script)

# Runtime-state dir (rate-limit counter, etc.). Optional — defaults to ./storage
# under this package. Point it at a writable volume for read-only/immutable deploys.
# FLUXFILES_STORAGE_PATH=/var/lib/fluxfiles

# Gated local media (optional). When true, files on the `local` disk are served
# through per-file /api/fm/stream tokens (Range-capable) instead of a static URL —
# so a <video> can't be opened without a valid token. The disk root must then NOT
# be served statically by the web server. Default off (static serving).
# FLUXFILES_LOCAL_PRIVATE=false
# Production: let nginx stream the bytes (native Range, no PHP copy) by pointing
# this at an internal location mapped to the disk root (see docker/nginx.conf).
# FLUXFILES_XACCEL=/_ff_media

# AI Auto-Tag (optional)
# Provider: 'claude' or 'openai' (leave empty to disable)
FLUXFILES_AI_PROVIDER=
FLUXFILES_AI_API_KEY=
FLUXFILES_AI_MODEL=
# Auto-tag images on upload (true/false). Tokens can override per tenant via `ai_auto_tag`.
FLUXFILES_AI_AUTO_TAG=false
