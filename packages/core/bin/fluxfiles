#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../autoload.php';

use FluxFiles\DiskManager;
use FluxFiles\ExistingFileIndexer;
use FluxFiles\StorageMetadataHandler;

$command = $argv[1] ?? '';

// `serve` — launch the standalone app from wherever the package lives (monorepo
// checkout OR an installed Composer dependency). It runs PHP's built-in server
// with the document root set to the package root, so /public, /assets, /api and
// /storage all resolve. This is the supported way to run FluxFiles standalone
// after `composer require fluxfiles/fluxfiles` (the package files live under
// vendor/fluxfiles/fluxfiles/, not your project root).
if ($command === 'serve') {
    // Parse --host/--port by hand: getopt() stops at the first non-option arg
    // ("serve"), so it would never see the flags that come after it.
    $serveOpts = [];
    foreach (array_slice($argv, 2) as $arg) {
        if (preg_match('/^--(host|port)=(.*)$/', $arg, $m)) {
            $serveOpts[$m[1]] = $m[2];
        }
    }
    $host = (string) ($serveOpts['host'] ?? '127.0.0.1');
    $port = (string) ($serveOpts['port'] ?? '8080');
    $root = dirname(__DIR__); // package root: has router.php, public/, api/, assets/, lang/
    $php = PHP_BINARY ?: 'php';

    fwrite(STDOUT, "FluxFiles standalone → http://{$host}:{$port}/public/\n");
    fwrite(STDOUT, "Document root: {$root}\n");
    fwrite(STDOUT, "(Make sure {$root}/.env sets FLUXFILES_SECRET. Press Ctrl+C to stop.)\n\n");

    if (!@chdir($root)) {
        fwrite(STDERR, "Cannot chdir to package root: {$root}\n");
        exit(1);
    }
    $cmd = escapeshellarg($php) . ' -S ' . escapeshellarg("{$host}:{$port}") . ' ' . escapeshellarg('router.php');
    passthru($cmd, $code);
    exit($code);
}

// `about` — what is running here: core version (and where it was read from),
// PHP, modules (installed / licensed / enabled), storage backend, disk drivers,
// external tools. Never prints a key, credential, endpoint or path.
//   fluxfiles about [--json]
if ($command === 'about') {
    $json = false;
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--json') { $json = true; }
        else {
            fwrite(STDERR, "Usage: fluxfiles about [--json]\n");
            exit(1);
        }
    }
    \FluxFiles\EnvBootstrap::load(\FluxFiles\EnvBootstrap::cliDirs(__DIR__));
    $about = \FluxFiles\AboutInfo::collect();
    fwrite(STDOUT, $json
        ? json_encode($about, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
        : \FluxFiles\AboutInfo::renderText($about));
    exit(0);
}

/** Is the automatic licence refresh switched off (FLUXFILES_LICENSE_REFRESH=false)? */
function fluxfiles_refresh_disabled(): bool
{
    $v = strtolower(trim((string) ($_ENV['FLUXFILES_LICENSE_REFRESH'] ?? '')));
    return in_array($v, ['false', '0', 'off', 'no'], true);
}

/** Refresh the licence key through the vendor licence server (never prints the key). */
function fluxfiles_license_refresh(bool $write): array
{
    $curl = new \FluxFiles\CurlTransport(5, \FluxFiles\LicenseRefresh::MAX_RESPONSE);
    return \FluxFiles\LicenseKeyFile::refresh($_ENV, [$curl, 'request'], $write);
}

/** Config warnings that affect where the refreshed key lives (stderr, never the key). */
function fluxfiles_license_path_warnings(): void
{
    foreach ([\FluxFiles\LicenseKeyFile::pathWarning($_ENV), \FluxFiles\LicenseKeyFile::vendorWarning($_ENV)] as $w) {
        if ($w !== null) {
            fwrite(STDERR, $w . "\n");
        }
    }
}

// `license refresh` — fetch the newest key of this subscription and keep it in a
// server-local file (FLUXFILES_LICENSE_FILE) that overlays FLUXFILES_LICENSE_KEY.
//   fluxfiles license refresh [--check] [--print] [--json]
// --check asks and reports without writing; --print writes the new key to stdout only
// (never to the file) for operators who manage secrets elsewhere.
// Exit: 0 refreshed/current/nothing to refresh, 1 usage/config, 2 network/server
// (retryable), 3 not available for this licence.
if ($command === 'license') {
    $check = $print = $json = false;
    $usage = ($argv[2] ?? '') !== 'refresh';
    foreach (array_slice($argv, 3) as $arg) {
        if ($arg === '--check') { $check = true; }
        elseif ($arg === '--print') { $print = true; }
        elseif ($arg === '--json') { $json = true; }
        else { $usage = true; }
    }
    if ($usage || ($check && $print)) {
        fwrite(STDERR, "Usage: fluxfiles license refresh [--check|--print] [--json]\n");
        exit(1);
    }
    \FluxFiles\EnvBootstrap::load(\FluxFiles\EnvBootstrap::cliDirs(__DIR__));
    fluxfiles_license_path_warnings();
    $res = fluxfiles_license_refresh(!$check && !$print);
    if (($res['stored'] ?? false) === true) {
        $pw = \FluxFiles\LicenseKeyFile::permissionWarning(\FluxFiles\LicenseKeyFile::path($_ENV), true);
        if ($pw !== null) {
            fwrite(STDERR, 'WARNING: ' . $pw . "\n");
        }
    }
    $exit = match ($res['outcome']) {
        'refreshed', 'current', 'nothing' => 0,
        'config' => 1,
        'unavailable', 'invalid', 'rejected' => 3,
        default => 2,
    };
    if ($json) {
        $out = ['status' => $res['outcome'], 'message' => $res['message']];
        foreach (['issued', 'expires', 'stored', 'retry_after'] as $f) {
            if (array_key_exists($f, $res)) { $out[$f] = $res[$f]; }
        }
        if ($print && isset($res['key'])) { $out['license_key'] = $res['key']; }
        fwrite(STDOUT, json_encode($out, JSON_UNESCAPED_SLASHES) . "\n");
    } elseif ($print && isset($res['key'])) {
        fwrite(STDOUT, $res['key'] . "\n");
        fwrite(STDERR, "Not stored. Put this key in FLUXFILES_LICENSE_KEY.\n");
    } else {
        $line = $res['message'];
        if ($res['outcome'] === 'refreshed') {
            $line = $check ? 'A newer licence key is available (not stored: --check).' : 'Licence key refreshed and stored.';
            if (isset($res['expires'])) { $line .= ' New expiry: ' . gmdate('Y-m-d', (int) $res['expires']) . '.'; }
        }
        fwrite($exit === 0 ? STDOUT : STDERR, $line . "\n");
    }
    exit($exit);
}

// `update` — self-hosted module updates. Asks the vendor update server (env
// FLUXFILES_UPDATE_URL) for a SIGNED manifest using the license key (env
// FLUXFILES_LICENSE_KEY), verifies the manifest + the zip's sha256, and installs
// the module into vendor/fluxfiles/<module>/. `--check` only reports.
//   fluxfiles update optimize [--check] [--force] [--no-refresh]
// Before asking, it refreshes the licence key (best-effort, never blocks the update; skipped by
// --no-refresh or FLUXFILES_LICENSE_REFRESH=false) and sends the effective, newest key.
// A release whose `requires_core` the running core doesn't satisfy is refused;
// --force only overrides an UNKNOWN core version (git checkout), never a known mismatch.
if ($command === 'update') {
    $module = '';
    $checkOnly = false;
    $force = false;
    $noRefresh = false;
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--check') { $checkOnly = true; }
        elseif ($arg === '--force') { $force = true; }
        elseif ($arg === '--no-refresh') { $noRefresh = true; }
        elseif (strncmp($arg, '--', 2) !== 0 && $module === '') { $module = $arg; }
    }
    if ($module === '' || !preg_match('/^[a-z0-9-]+$/', $module)) {
        fwrite(STDERR, "Usage: fluxfiles update <module> [--check] [--force] [--no-refresh]\n");
        exit(1);
    }

    // Load .env (cwd, host project root, package root; see EnvBootstrap::cliDirs) so
    // the license + update URL are available (mirrors the index command below).
    \FluxFiles\EnvBootstrap::load(\FluxFiles\EnvBootstrap::cliDirs(__DIR__));
    $updateBase = rtrim((string) ($_ENV['FLUXFILES_UPDATE_URL'] ?? 'https://fluxfiles-updates.thai-pc.com'), '/');
    $license = (string) ($_ENV['FLUXFILES_LICENSE_KEY'] ?? '');
    if ($license === '') {
        fwrite(STDERR, "No FLUXFILES_LICENSE_KEY set — updates require a license.\n");
        exit(1);
    }

    // A renewed perpetual licence only opens the update window with its NEWEST key, so
    // refresh first and send the effective key. Best-effort: one stderr line, then carry on.
    if (!$noRefresh && !fluxfiles_refresh_disabled()) {
        fluxfiles_license_path_warnings();
        try {
            $refreshed = fluxfiles_license_refresh(true);
            if (($refreshed['stored'] ?? false) === true) {
                $pw = \FluxFiles\LicenseKeyFile::permissionWarning(\FluxFiles\LicenseKeyFile::path($_ENV), true);
                if ($pw !== null) {
                    fwrite(STDERR, 'WARNING: ' . $pw . "\n");
                }
            }
            if (in_array($refreshed['outcome'], ['unavailable', 'invalid', 'rejected', 'throttled', 'error', 'config'], true)) {
                fwrite(STDERR, 'Licence refresh skipped: ' . $refreshed['message'] . "\n");
            }
        } catch (\Throwable $e) {
            fwrite(STDERR, "Licence refresh skipped: unexpected error\n");
        }
    }
    $license = trim(\FluxFiles\LicenseKeyFile::effectiveKey($_ENV));

    // Where the module lives: vendor/fluxfiles/<module> relative to the host's
    // autoloader (two levels up when installed as a dependency), else a sibling of
    // packages/core in a monorepo checkout.
    $vendorBase = realpath(__DIR__ . '/../../..');
    $dest = (is_string($vendorBase) && is_dir($vendorBase . '/fluxfiles'))
        ? $vendorBase . '/fluxfiles/' . $module
        : dirname(__DIR__, 2) . '/' . $module;

    // New installs record this after a verified activation. Composer's version is
    // a compatibility fallback for modules installed by an older client.
    $current = '0.0.0';
    $installed = is_dir($dest);
    $versionFile = $dest . '/.fluxfiles-version';
    if (is_file($versionFile)) {
        $candidate = trim((string) @file_get_contents($versionFile));
        if ($candidate !== '') { $current = $candidate; }
    } elseif (is_file($dest . '/composer.json')) {
        $package = json_decode((string) @file_get_contents($dest . '/composer.json'), true);
        if (is_array($package) && is_string($package['version'] ?? null) && $package['version'] !== '') {
            $current = $package['version'];
        }
    }

    $coreVersion = \FluxFiles\CoreVersion::current();
    $url = $updateBase . '/update/' . rawurlencode($module)
        . '?current=' . rawurlencode($current)
        . ($coreVersion !== null ? '&core_version=' . rawurlencode($coreVersion) : '');
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 20,
        CURLOPT_FOLLOWLOCATION => false,
        CURLOPT_HTTPHEADER => ['Authorization: Bearer ' . $license],
    ]);
    $body = curl_exec($ch);
    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($status === 409 && is_string($body)) {
        // The server found no release this core can host: say so, not "licence invalid".
        $msg = trim((string) preg_replace('/[\x00-\x1F\x7F]+/', ' ', substr($body, 0, 300)));
        fwrite(STDERR, ($msg !== '' ? $msg : "No release of {$module} is compatible with this core - update core first.") . "\n");
        exit(1);
    }
    if ($body === false || $status !== 200) {
        fwrite(STDERR, "Update check failed (HTTP {$status}). License invalid/expired, or server unreachable.\n");
        exit(1);
    }

    $client = new \FluxFiles\UpdateClient();
    $manifest = $client->verifyManifest((string) $body, null, $module);
    if ($manifest === null) {
        fwrite(STDERR, "Update manifest failed signature verification — refusing.\n");
        exit(1);
    }
    $version = (string) ($manifest['version'] ?? '');
    fwrite(STDOUT, "Latest {$module}: {$version}" . ($installed ? '' : ' (not currently installed)') . "\n");
    if ($installed && !\FluxFiles\UpdateClient::isNewer($version, $current)) {
        fwrite(STDOUT, "Already current ({$current}).\n");
        exit(0);
    }
    try {
        $warning = \FluxFiles\UpdateClient::assertCoreCompatible($manifest, $coreVersion, $force);
    } catch (\FluxFiles\ApiException $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    if ($warning !== null) {
        fwrite(STDERR, "WARNING: {$warning}\n");
    }
    if ($checkOnly) {
        exit(0);
    }

    fwrite(STDOUT, "Downloading {$module} {$version}…\n");
    $ch = curl_init((string) $manifest['url']);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 120, CURLOPT_FOLLOWLOCATION => true]);
    $zip = curl_exec($ch);
    $zstatus = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($zip === false || $zstatus !== 200 || !\FluxFiles\UpdateClient::verifyZip((string) $zip, (string) $manifest['sha256'])) {
        fwrite(STDERR, "Download failed or checksum mismatch — refusing to install.\n");
        exit(1);
    }

    // Defense in depth: the zip's own composer.json (bytes bound to the signed sha256)
    // must also accept this core, whatever the catalogue said.
    $zipNeed = null;
    $za = new \ZipArchive();
    $tmpZip = tempnam(sys_get_temp_dir(), 'ffz');
    if ($tmpZip !== false) {
        if (@file_put_contents($tmpZip, (string) $zip) !== false && $za->open($tmpZip) === true) {
            $cj = $za->getFromName('composer.json');
            $za->close();
            $pkg = is_string($cj) ? json_decode($cj, true) : null;
            $rc = is_array($pkg) ? ($pkg['require']['fluxfiles/fluxfiles'] ?? null) : null;
            $zipNeed = is_string($rc) && trim($rc) !== '' ? trim($rc) : null;
        }
        @unlink($tmpZip);
    }
    if ($zipNeed !== null) {
        try {
            \FluxFiles\UpdateClient::assertCoreCompatible(
                ['module' => $module, 'version' => $version, 'requires_core' => $zipNeed],
                $coreVersion,
                $force
            );
        } catch (\FluxFiles\ApiException $e) {
            fwrite(STDERR, $e->getMessage() . "\n");
            exit(1);
        }
    }

    try {
        $client->install((string) $zip, $dest);
    } catch (\FluxFiles\ApiException $e) {
        fwrite(STDERR, 'Install failed: ' . $e->getMessage() . "\n");
        exit(1);
    }
    if (@file_put_contents($versionFile, $version . "\n", LOCK_EX) === false) {
        fwrite(STDERR, "Installed module but could not record its version; future checks may re-download it.\n");
    }
    fwrite(STDOUT, "Installed {$module} {$version} → {$dest}\nRun `composer dump-autoload` if needed.\n");
    exit(0);
}

// `notify:run` — the e-mail notice sweep from a system cron (hourly), the standalone
// counterpart of `POST /api/fm/notify/run`. Claims come from FLUXFILES_NOTIFY_* env, mail
// from FLUXFILES_MAIL_*; needs the Intake or Share module installed + licensed.
//   fluxfiles notify:run [--disk=local] [--prefix=] [--dry-run] [--max=50]
// Exit: 0 ok, 1 usage/config/gate, 2 the sweep itself failed.
if ($command === 'notify:run') {
    $nOpts = ['disk' => 'local', 'prefix' => '', 'max' => 50, 'dry_run' => false];
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--dry-run') { $nOpts['dry_run'] = true; }
        elseif (preg_match('/^--(disk|prefix|max)=(.*)$/s', $arg, $m)) {
            if ($m[1] === 'max') {
                if (!ctype_digit($m[2]) || (int) $m[2] < 1) {
                    fwrite(STDERR, "Option --max needs a positive number.\n");
                    exit(1);
                }
                $nOpts['max'] = (int) $m[2];
            } elseif ($m[1] === 'disk' && $m[2] === '') {
                fwrite(STDERR, "Option --disk is empty (an unset shell variable?). Omit it to use 'local'.\n");
                exit(1);
            } else {
                $nOpts[$m[1]] = $m[2];
            }
        } else {
            fwrite(STDERR, "Usage: fluxfiles notify:run [--disk=local] [--prefix=] [--dry-run] [--max=50]\n");
            exit(1);
        }
    }
    \FluxFiles\EnvBootstrap::load(\FluxFiles\EnvBootstrap::cliDirs(__DIR__));
    try {
        $nDisks = \FluxFiles\DiskConfig::load(__DIR__ . '/../config/disks.php');
    } catch (\FluxFiles\ApiException $e) {
        fwrite(STDERR, ($e instanceof \FluxFiles\DiskConfigException ? $e->getDetail() : $e->getMessage()) . "\n");
        exit(1);
    }
    if (!isset($nDisks[$nOpts['disk']])) {
        fwrite(STDERR, "Disk '{$nOpts['disk']}' is not configured.\n");
        exit(1);
    }
    $nDm = new DiskManager($nDisks);
    $nMeta = null;
    if (($_ENV['FLUXFILES_STORAGE_BACKEND'] ?? 'json') === 'db') {
        $nMeta = new \FluxFiles\Db\DbMetadataHandler(\FluxFiles\Db\Connection::fromEnv(), $nDm);
    }
    $nWhy = null;
    $nMailer = \FluxFiles\Mail\MailTransportFactory::fromEnv(null, null, $nWhy);
    try {
        $report = \FluxFiles\NotifyScheduler::run($_ENV, $nOpts, $nDm, $nMailer, $nMeta);
    } catch (\FluxFiles\ApiException $e) {
        fwrite(STDERR, $e->getMessage() . ($nMailer === null && $nWhy !== null ? " ({$nWhy})" : '') . "\n");
        exit(1);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Notify sweep failed (' . get_class($e) . ")\n");
        exit(2);
    }
    fwrite(STDOUT, sprintf(
        "%s: sent %d, coalesced %d, rate-limited %d%s.\n",
        $report['dry_run'] ? 'Dry run' : 'Done',
        $report['sent'], $report['coalesced'], $report['rate_limited'],
        !empty($report['truncated']) ? ', truncated (raise --max or run again)' : ''
    ));
    foreach ($report['skipped'] as $sk) {
        fwrite(STDERR, "Skipped {$sk['module']}: {$sk['reason']} (update the module).\n");
    }
    exit(0);
}

if (!in_array($command, ['index', 'seed'], true)) {
    fwrite(STDERR, "Usage:\n"
        . "  fluxfiles serve [--host=127.0.0.1] [--port=8080]\n"
        . "  fluxfiles about [--json]\n"
        . "  fluxfiles update <module> [--check] [--force] [--no-refresh]\n"
        . "  fluxfiles license refresh [--check|--print] [--json]\n"
        . "  fluxfiles notify:run [--disk=local] [--prefix=] [--dry-run] [--max=50]\n"
        . "  fluxfiles index --disk=local [--path=prefix] [--owner=user-id] [--readonly] [--overwrite] [--dry-run] [--hash] [--variants] [--persist-metadata]\n");
    exit(1);
}

// Parse the flags by hand: getopt() stops at the first non-option arg ("index"),
// so it would return [] and silently drop every flag (including --dry-run).
$valueOpts = ['disk', 'path', 'owner'];
$flagOpts = ['readonly', 'overwrite', 'dry-run', 'hash', 'variants', 'persist-metadata'];
$opts = [];
foreach (array_slice($argv, 2) as $arg) {
    if (!preg_match('/^--([a-z-]+)(?:=(.*))?$/s', $arg, $m)) {
        fwrite(STDERR, "Unexpected argument '{$arg}'. Options look like --name=value or --flag.\n");
        exit(1);
    }
    $name = $m[1];
    $hasValue = isset($m[2]);
    if (in_array($name, $valueOpts, true)) {
        if (!$hasValue) {
            fwrite(STDERR, "Option --{$name} needs a value: --{$name}=<value>.\n");
            exit(1);
        }
        if ($m[2] === '') {
            fwrite(STDERR, "Option --{$name} is empty (an unset shell variable?). Refusing to continue; omit the option to use its default.\n");
            exit(1);
        }
        $opts[$name] = $m[2];
    } elseif (in_array($name, $flagOpts, true)) {
        if ($hasValue) {
            fwrite(STDERR, "Option --{$name} does not take a value.\n");
            exit(1);
        }
        $opts[$name] = false;
    } else {
        fwrite(STDERR, "Unknown option --{$name}.\n");
        exit(1);
    }
}

\FluxFiles\EnvBootstrap::load(\FluxFiles\EnvBootstrap::cliDirs(__DIR__));
\FluxFiles\SsrfGuard::setAllowHosts((string) ($_ENV['FLUXFILES_SSRF_ALLOW_HOSTS'] ?? ''));

try {
    $diskConfigs = \FluxFiles\DiskConfig::load(__DIR__ . '/../config/disks.php');
} catch (\FluxFiles\ApiException $e) {
    fwrite(STDERR, ($e instanceof \FluxFiles\DiskConfigException ? $e->getDetail() : $e->getMessage()) . "\n");
    exit(1);
}
$disk = (string) ($opts['disk'] ?? 'local');
if (!isset($diskConfigs[$disk])) {
    fwrite(STDERR, "Disk '{$disk}' is not configured.\n");
    exit(1);
}

$dm = new DiskManager($diskConfigs);
$indexer = new ExistingFileIndexer($dm, new StorageMetadataHandler($dm));

$stats = $indexer->index([
    'disk' => $disk,
    'path' => (string) ($opts['path'] ?? ''),
    'owner' => $opts['owner'] ?? null,
    'readonly' => isset($opts['readonly']),
    'overwrite' => isset($opts['overwrite']),
    'dry_run' => isset($opts['dry-run']),
    'hash' => isset($opts['hash']),
    'variants' => isset($opts['variants']),
    'persist_metadata' => isset($opts['persist-metadata']),
    'on_item' => static function (string $type, string $key, array $stats, ?Throwable $error): void {
        if ($type === 'error') {
            fwrite(STDERR, "[error] {$key}: {$error->getMessage()}\n");
            return;
        }
        if (($stats['files_indexed'] + $stats['folders_indexed'] + $stats['skipped']) % 250 === 0) {
            fwrite(STDOUT, '.');
        }
    },
]);

fwrite(STDOUT, "\nDone. Files indexed: {$stats['files_indexed']}, folders indexed: {$stats['folders_indexed']}, skipped: {$stats['skipped']}, hashed: {$stats['hashed']}, variants: {$stats['variants']}, errors: {$stats['errors']}.\n");
exit($stats['errors'] > 0 ? 2 : 0);
