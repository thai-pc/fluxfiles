# Files that live in the repo but never ship in the WordPress.org / release zip.
# Consumed by scripts/build-wordpress.sh via `rsync --exclude-from`.
# Anchored (leading /) so only the top level is matched. readme.txt and LICENSE are
# kept; every *.md is dropped (WordPress.org allows no other markdown in the plugin
# root). build-wordpress.sh ships HOOKS.md and THIRD-PARTY-NOTICES.md under docs/.
/vendor/
/node_modules/
/build/
/tests/
/composer.json
/composer.lock
/.distignore
/.wordpress-org/
.DS_Store
.gitignore
.gitattributes
*.md
phpcs.xml*
.phpcs*
.plugin-check-ignore
phpunit*
.git*
