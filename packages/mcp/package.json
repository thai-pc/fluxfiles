{
  "name": "@fluxfiles/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for FluxFiles — let AI agents browse, search and read (and optionally write) files through a scoped FluxFiles JWT",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fluxfiles-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "author": "thai-pc",
  "homepage": "https://github.com/thai-pc/fluxfiles/tree/master/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thai-pc/fluxfiles.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/thai-pc/fluxfiles/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["fluxfiles", "mcp", "model-context-protocol", "ai", "agent", "file-manager", "claude"]
}
