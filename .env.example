# App
# Must be at least 32 bytes (256-bit) — firebase/php-jwt v7 rejects shorter HS256 keys.
FLUXFILES_SECRET=change-me-to-random-32-char-string
FLUXFILES_ALLOWED_ORIGINS=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
# Custom S3-compatible endpoint — empty for native AWS S3; set for MinIO /
# DigitalOcean Spaces / other S3-compatibles (e.g. http://localhost:9000).
AWS_ENDPOINT=
AWS_VISIBILITY=private
AWS_PUBLIC_URL=
# Presigned GET-URL lifetime (seconds) on a private disk; default 3600 = 1h, max 24h.
# AWS_URL_TTL=3600

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_VISIBILITY=private
R2_PUBLIC_URL=
# R2_URL_TTL=3600                        # presigned GET-URL lifetime (seconds), max 24h

# Locale (optional, default: en)
# Supported: en, vi, zh, ja, ko, fr, de, es, ar, pt, it, ru, th, hi, tr, nl
# Leave empty for English. Users can override via ?lang= or ?locale= URL param.
FLUXFILES_LOCALE=

# Rate limit (optional, for tests use higher values)
# FLUXFILES_RATE_LIMIT_READ=60
# FLUXFILES_RATE_LIMIT_WRITE=100

# Import from URL (optional). The feature is enabled per-tenant via the
# `allow_url_import` JWT claim; these are server-wide defaults/limits.
# FLUXFILES_IMPORT_MAX_MB=50            # max MB per import when the token doesn't set max_import_mb
# FLUXFILES_IMPORT_TIMEOUT=30           # seconds per import fetch
# FLUXFILES_IMPORT_RATE_LIMIT=10        # imports/min when the token doesn't set import_rate_limit
# FLUXFILES_IMPORT_ALLOW_SVG=false      # SVG import is off by default (XML can carry script)

# Runtime-state dir (rate-limit counter). Optional — defaults to packages/core/storage.
# Point it at a writable volume for read-only/immutable deployments.
# FLUXFILES_STORAGE_PATH=/var/lib/fluxfiles

# Gated local media (optional). When true, `local` disk files are served through
# per-file /api/fm/stream tokens (Range-capable) instead of a static URL; the disk
# root must then NOT be served statically. Default off.
# FLUXFILES_LOCAL_PRIVATE=false
# FLUXFILES_XACCEL=/_ff_media            # let nginx stream bytes via X-Accel-Redirect

# AI Auto-Tag (optional)
# Provider (leave empty to disable). Bring your own key — nothing is proxied.
#   claude | anthropic   Anthropic Messages API
#   gemini | google      Google Gemini
#   openai               OpenAI
#   openrouter, groq, mistral, xai/grok, ollama   OpenAI-compatible gateways
#   compatible           any other OpenAI-compatible endpoint (set _BASE_URL + _MODEL)
FLUXFILES_AI_PROVIDER=
FLUXFILES_AI_API_KEY=
# Leave empty to use the provider's default vision model.
FLUXFILES_AI_MODEL=
# Override the API base URL — required for `compatible`, optional for the rest
# (self-hosted Ollama/LiteLLM/vLLM, or a corporate gateway).
FLUXFILES_AI_BASE_URL=
# Auto-tag images on upload (true/false)
FLUXFILES_AI_AUTO_TAG=false

# ─────────────────────────────────────────────────────────────────────────────
# Commercial / vendor back-office. None of this is needed to run FluxFiles —
# it is for the person SELLING it. See docs/OPERATIONS.md.
# ─────────────────────────────────────────────────────────────────────────────

# A licence key you BOUGHT, to unlock paid modules on this install.
# WordPress stores it in Settings → FluxFiles instead (shared hosting has no env).
FLUXFILES_LICENSE_KEY=

# Where `fluxfiles update <module>` asks for signed release manifests.
FLUXFILES_UPDATE_URL=https://updates.fluxfiles.dev

# Polar API tokens, for the store owner only. Sandbox and production are separate
# organisations with separate tokens — one will not work against the other.
# Never paste these into a chat, an issue or a commit: they can create products and
# change prices. Rotate under Polar → Settings → Developers if one leaks.
POLAR_TOKEN=
POLAR_TOKEN_SANDBOX=
