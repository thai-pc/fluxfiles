# FluxFiles license-server — copy to `.env` and fill in.
# server.php reads process env vars only (see its env() helper) — it does NOT
# load this file. Export these on whatever host actually runs server.php, or
# source a real `.env` into the environment yourself before starting it.

# 1. Ed25519 signing secret (the one matching core's embedded k1).
#    It's in docs/license-signing-key.key (gitignored). NEVER commit it.
FLUXFILES_LICENSE_PRIVATE_KEY_FILE=/secure/path/license-signing-key.key
# — or inline the key contents instead of a file path:
# FLUXFILES_LICENSE_PRIVATE_KEY=

FLUXFILES_LICENSE_DB=/var/lib/fluxfiles/licenses.sqlite
# openssl rand -hex 24 — protects /issue, /licenses, /revoke
FLUXFILES_LICENSE_ADMIN_TOKEN=

# Override the default plan catalogue with a JSON file (optional; see Plans.php).
# FLUXFILES_LICENSE_PLANS=

# CORS allow-origin for GET /claim, which hands back a secret (unset = no
# cross-origin access at all; the origin is checked with hash_equals, no wildcard).
# FLUXFILES_LANDING_ORIGIN=

# 2. Polar (the store)
FLUXFILES_POLAR_WEBHOOK_SECRET=
FLUXFILES_POLAR_PLAN_MAP={"<product_id>":"pro","<product_id>":"studio"}

# 3. Licence delivery. Default transport is 'log' — an unconfigured server
# writes the message to error_log instead of silently pretending it sent mail.
FLUXFILES_MAIL_TRANSPORT=log
FLUXFILES_MAIL_FROM=licenses@your-domain.com
FLUXFILES_MAIL_FROM_NAME=FluxFiles
# FLUXFILES_MAIL_REPLY_TO=support@your-domain.com

# transport=resend
# FLUXFILES_RESEND_API_KEY=

# transport=smtp (alternative to resend)
# FLUXFILES_SMTP_HOST=
# FLUXFILES_SMTP_PORT=587
# FLUXFILES_SMTP_USER=
# FLUXFILES_SMTP_PASS=
# FLUXFILES_SMTP_TLS=tls

# 4. Renewal reminders (send-renewal-reminders.php cron). Day-out thresholds,
# descending. Reuses every mail var above — no separate transport config.
# FLUXFILES_LICENSE_REMINDER_DAYS=30,14,7,1

# polar-setup.php only (not read by server.php) — run as
#   POLAR_TOKEN=polar_oat_... php services/license-server/polar-setup.php
# POLAR_TOKEN=
# POLAR_TOKEN_SANDBOX=
