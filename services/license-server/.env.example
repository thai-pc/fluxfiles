# FluxFiles license-server — copy to `.env` and fill in.
# server.php reads process env vars only (see its env() helper) — it does NOT
# load this file. Export these on whatever host actually runs server.php, or
# source a real `.env` into the environment yourself before starting it.

# 1. Ed25519 signing secret (the one matching core's embedded k1).
#    It's in docs/license-signing-key.key (gitignored). NEVER commit it.
FLUXFILES_LICENSE_PRIVATE_KEY_FILE=/secure/path/license-signing-key.key
# — or inline the key contents instead of a file path:
# FLUXFILES_LICENSE_PRIVATE_KEY=

FLUXFILES_LICENSE_DB=/var/lib/fluxfiles/licenses.sqlite
# openssl rand -hex 24 — protects /issue, /licenses, /revoke
FLUXFILES_LICENSE_ADMIN_TOKEN=

# Override the default plan catalogue with a JSON file (optional; see Plans.php).
# FLUXFILES_LICENSE_PLANS=

# CORS allow-origin for GET /claim, which hands back a secret (unset = no
# cross-origin access at all; the origin is checked with hash_equals, no wildcard).
# FLUXFILES_LANDING_ORIGIN=https://fluxfiles.example   (https://host, no path). Also the only origin
# allowed to call POST /pro-download, and the base of the /download link in the licence e-mail.

# 2. Polar (the store)
FLUXFILES_POLAR_WEBHOOK_SECRET=
FLUXFILES_POLAR_PLAN_MAP={"<product_id>":"pro","<product_id>":"studio"}

# 3. Licence delivery. Default transport is 'log' — an unconfigured server
# writes the message to error_log instead of silently pretending it sent mail.
FLUXFILES_MAIL_TRANSPORT=log
FLUXFILES_MAIL_FROM=licenses@your-domain.com
FLUXFILES_MAIL_FROM_NAME=FluxFiles
# FLUXFILES_MAIL_REPLY_TO=support@your-domain.com

# Sandbox instance only (see README "Sandbox instance"); leave unset in production.
# FLUXFILES_MAIL_SUBJECT_PREFIX=[SANDBOX]   prepended + one space to every subject (control chars stripped, max 32)
# FLUXFILES_MAIL_ALLOW_TO=me@example.com,@my-team.example   only these exact addresses / @domain suffixes get mail
# FLUXFILES_LICENSE_INSTANCE=sandbox        /health answers {"ok":true,"instance":"sandbox"}

# transport=resend
# FLUXFILES_RESEND_API_KEY=

# transport=smtp (alternative to resend)
# FLUXFILES_SMTP_HOST=
# FLUXFILES_SMTP_PORT=587
# FLUXFILES_SMTP_USER=
# FLUXFILES_SMTP_PASS=
# FLUXFILES_SMTP_TLS=tls

# Update-server revocation check (POST /update-status); separate from the admin token.
FLUXFILES_UPDATE_STATUS_TOKEN=
# Optional lifetime/renewal deal: also notified when a renewal cannot be matched to a
# licence or a refund cancels renewals; and the link quoted in one-time-plan reminders.
# FLUXFILES_OPS_EMAIL=ops@your-domain.com
# FLUXFILES_RENEWAL_URL=https://your-domain.com/pricing

# 4. Renewal reminders (send-renewal-reminders.php cron). Day-out thresholds,
# descending. Reuses every mail var above — no separate transport config.
# FLUXFILES_LICENSE_REMINDER_DAYS=30,14,7,1

# polar-setup.php only (not read by server.php) — run as
#   POLAR_TOKEN=polar_oat_... php services/license-server/polar-setup.php
# POLAR_TOKEN=
# POLAR_TOKEN_SANDBOX=

# Optional: update-server base URL (https). When set, /claim returns a signed, expiring download link
# for the FluxFiles Pro WordPress zip, POST /pro-download serves the landing /download page, and the
# licence e-mail points at that page (plans with share/intake only; the mail also needs
# FLUXFILES_LANDING_ORIGIN). Unset = no Pro download anywhere.
# FLUXFILES_PRO_UPDATE_URL=https://fluxfiles-updates.thai-pc.com

# Key refresh (POST /refresh). Days after a key's expiry + grace beyond which it can no
# longer fetch its subscription's newest key (bounds the value of an old leaked key).
# FLUXFILES_REFRESH_MAX_STALE_DAYS=90
# backfill-subscription-ids.php reads POLAR_TOKEN (above), or --token-file=PATH.

# 5. Admin (all phases). Every instance has DISTINCT tokens, DBs, users and worker state.
# All four machine tokens must be nonempty/pairwise unique; all eight across both instances differ.
# Production defaults: API 127.0.0.1:9471, UI 127.0.0.1:9472.
# Sandbox: set FLUXFILES_LICENSE_INSTANCE=sandbox; API :9473, UI :9474.
# Role must be set separately in each php-fpm pool; all is for local tests only.
# FLUXFILES_LICENSE_ROLE=public                  # public | status | admin-api | all
# Licence-user copies (0400); process env instead of _FILE is also supported:
# FLUXFILES_LICENSE_ADMIN_TOKEN_FILE=/etc/fluxfiles-license/admin.token
# FLUXFILES_UPDATE_STATUS_TOKEN_FILE=/etc/fluxfiles-license/update-status.token
# FLUXFILES_LICENSE_UI_TOKEN_FILE=/etc/fluxfiles-license/ui.token
# FLUXFILES_LICENSE_UI_TOKEN=
# FLUXFILES_LICENSE_OPS_TOKEN_FILE=/etc/fluxfiles-license/ops.token
# FLUXFILES_LICENSE_OPS_TOKEN=
# FLUXFILES_POLAR_WEBHOOK_SECRET_FILE=/etc/fluxfiles-license/polar-webhook.secret
# FLUXFILES_RESEND_WEBHOOK_SECRET_FILE=/etc/fluxfiles-license/resend-webhook.secret
# FLUXFILES_RESEND_WEBHOOK_SECRET=
# FLUXFILES_LICENSE_NET_PEPPER_FILE=/etc/fluxfiles-license/install-net.pepper
# FLUXFILES_LICENSE_K1_PUB=                       # public base64 Ed25519 key; refresh and comparison
# FLUXFILES_LICENSE_BACKUP_STATUS=/var/lib/fluxfiles-license/backup-status.json
# FLUXFILES_ADMIN_TRACKED_DISCOUNTS=FOUNDING40:50
# FLUXFILES_ADMIN_TZ=Asia/Ho_Chi_Minh

# UI pool ONLY: no signing-key or licence-DB settings, no licence Unix group.
# FLUXFILES_ADMIN_API=http://127.0.0.1:9471        # sandbox default is :9473; literal http loopback only
# FLUXFILES_ADMIN_UI_TOKEN_FILE=/etc/fluxfiles-license-admin/ui.token
# FLUXFILES_ADMIN_UI_TOKEN=
# FLUXFILES_ADMIN_DB=/var/lib/fluxfiles-license-admin/admin.sqlite
# FLUXFILES_ADMIN_HOSTS=prod.localhost             # sandbox: sbx.localhost; host-only cookies require different hostnames
# FLUXFILES_ADMIN_LANG=vi                        # vi | en
# FLUXFILES_ADMIN_SESSION_IDLE=1800
# FLUXFILES_ADMIN_SESSION_ABSOLUTE=43200
# FLUXFILES_ADMIN_POLAR_ORG=
# FLUXFILES_ADMIN_POLAR_ORDER_URL=https://polar.sh/dashboard/{org}/sales/{id}
# FLUXFILES_ADMIN_POLAR_SUBSCRIPTION_URL=https://polar.sh/dashboard/{org}/sales/subscriptions/{id}
# FLUXFILES_ADMIN_POLAR_CUSTOMER_URL=https://polar.sh/dashboard/{org}/customers/{id}

# Ops user ONLY: own copy of its token; never include signing-key or licence-DB env.
# FLUXFILES_LICENSE_OPS_TOKEN_FILE=/etc/fluxfiles-license-ops/ops.token
# FLUXFILES_OPS_STATE_DIR=/var/lib/fluxfiles-license-ops
# FLUXFILES_OPS_HEALTH_TARGETS=[{"name":"license","url":"https://license.example/health","expect_status":200},{"name":"updates","url":"https://updates.example/health","expect_status":200},{"name":"demo","url":"https://demo.example/","expect_status":200},{"name":"landing","url":"https://example/","expect_status":200}]
# FLUXFILES_OPS_DISK_PATHS=/                     # comma-separated mount points
# FLUXFILES_TELEGRAM_BOT_TOKEN_FILE=/etc/fluxfiles-license-ops/telegram.token
# FLUXFILES_TELEGRAM_CHAT_ID=
# FLUXFILES_TELEGRAM_THREAD_ID=
# FLUXFILES_TELEGRAM_TAG=FluxFiles               # sandbox default: FluxFiles SANDBOX
# FLUXFILES_TELEGRAM_SANDBOX=0                   # explicit 1 to enable in sandbox; crit only
# FLUXFILES_TELEGRAM_COMMANDS=0                  # explicit 1 for read-only /stats, /today, /help
# FLUXFILES_TELEGRAM_ADMIN_USER_ID=              # required for commands in a supergroup

# Test seams (no external credentials; alternatives must be literal http loopback).
# FLUXFILES_TELEGRAM_API_BASE=https://api.telegram.org
# FLUXFILES_RESEND_API_BASE=https://api.resend.com
# FLUXFILES_ADMIN_TEST_CLOCK=0                   # cli-server only; NEVER enable in production
# With the flag above, X-FluxFiles-Test-Time sets the auth clock in HTTP tests.


# Phase 2/3 API pool settings (no new JWT claims).
# FLUXFILES_LICENSE_BACKUP_STAGE=/var/lib/fluxfiles-license/backup-stage
# FLUXFILES_ADMIN_ANALYTICS_URL=https://dash.cloudflare.com/
# FLUXFILES_ADMIN_DEMO_BUDGET_BYTES=0
# FLUXFILES_ADMIN_POLAR_ACTIONS=0                 # optional runtime scoped token, never stored
# FLUXFILES_POLAR_API_BASE=https://api.polar.sh/v1 # sandbox default: https://sandbox-api.polar.sh/v1
# Backup status: {last_ok_at,file,bytes,integrity:"ok",kept,oldest_at,last_error}.
# Root sweeps staged snapshots; no HTTP backup downloads.

# Ops public counters: max 20 requests/day; empty disables all external fetches.
# FLUXFILES_OPS_PUBLIC_COUNTERS={"wporg":["fluxfiles"],"github":["owner/repo"],"packagist":["vendor/pkg"],"npm":["@scope/pkg"]}
# FLUXFILES_OPS_COUNTER_API_BASE=                 # loopback fake-provider override only
# Root collector drops privilege, writes 0640 ops:ops-group <day>.json into ops-owned 0750 inbox/.
# Worker reads counts only, never raw logs. See collect-ops.php and README.

# UI optional Access gate: leave off for SSH-tunnel-only mode.
# Does not replace password/TOTP. All settings required when enabled.
# FLUXFILES_ADMIN_ACCESS_ENABLED=0
# FLUXFILES_ADMIN_ACCESS_HOST=admin.example.com
# FLUXFILES_ADMIN_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# FLUXFILES_ADMIN_ACCESS_AUD=
# FLUXFILES_ADMIN_ACCESS_JWKS_FILE=/etc/fluxfiles-license-admin/access-jwks.json
# Root refresh: php admin/cli/access-keys.php (hourly); UI refuses keys older than 24h.
# Browser test only (not a runtime PHP setting):
# FLUXFILES_TEST_PLAYWRIGHT_MODULE=/path/to/node_modules/playwright
# FLUXFILES_TEST_PHP_BINARY=php
# FLUXFILES_TEST_OUTPUT_DIR=/tmp/fluxfiles-admin-screenshots
# FLUXFILES_ADMIN_LANG=vi                        # API + worker alert/report language: vi | en
# API/UI ports 9471/9472 (sbx 9473/9474) must bind loopback only.
# Optional cancel token is organisation-wide; use short expiry and revoke after use.
